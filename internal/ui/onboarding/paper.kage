// The paper over the tide: the small current (image0) spread over the
// window, a grain in every pixel and its edges a little darker.

package main

// Grain is how coarse the paper is, Vignette how much its edges darken.
var Grain float
var Vignette float

func hash(p vec2) float {
	p = fract(p * vec2(123.34, 456.21))
	p += dot(p, p+45.32)
	return fract(p.x * p.y)
}

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	col := image0Sample(pos / size * image0Size()).rgb
	edge := pos/size - 0.5
	col *= 1 - Vignette*dot(edge, edge)
	col += (hash(floor(dst.xy)) - 0.5) * Grain
	return vec4(col, 1)
}
