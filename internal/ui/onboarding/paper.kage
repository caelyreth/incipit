// The ground of the walkthrough: laid paper, as a well-made book is
// printed on. Fine laid lines run across it a few points apart, the
// chain lines that held them stand far apart down it, the sheet a little
// thicker beside each; a fibre grain in every pixel; light falling from
// above; and one wash of the accent's ink in a corner, as a print's color
// bleeds, sliding as the pages turn (Drift). Every term is closed form,
// a few dozen operations a pixel, and nothing moves on its own.

package main

// Ground is the paper; Line the ink of its laid and chain lines, its alpha
// how strongly they show; Wash the accent's bleed, its alpha how strongly;
// Light how much brighter the top of the sheet is; Drift how far the
// pages have turned.
var Ground vec4
var Line vec4
var Wash vec4
var Light float
var Drift float

func hash(p vec2) float {
	p = fract(p * vec2(123.34, 456.21))
	p += dot(p, p+45.32)
	return fract(p.x * p.y)
}

// rule is a line width wide at distance d from its middle, its edges a
// pixel soft.
func rule(d, width, aa float) float {
	return 1 - smoothstep(width*0.5, width*0.5+aa, d)
}

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	uv := pos / size
	aa := 1 / pixelScale()

	// Laid lines, 3.2 DIPs apart, wavering as the wires did.
	laidPitch := 3.2
	y := pos.y + 0.6*sin(pos.x/97.0+pos.y/310.0)
	laid := rule(abs(fract(y/laidPitch)-0.5)*laidPitch, 0.55, aa)
	// Chain lines, 118 DIPs apart, and the sheet's tone thicker beside each.
	chainPitch := 118.0
	x := pos.x + 1.4*sin(pos.y/140.0)
	dc := abs(fract(x/chainPitch)-0.5) * chainPitch
	chain := rule(dc, 0.9, aa)
	beside := exp(-dc * dc / 260.0)

	col := Ground.rgb
	col = mix(col, Line.rgb, (0.6*laid+0.3*chain+0.45*beside)*Line.a)

	// The accent bleeds in from the lower right, slid by the pages.
	at := vec2(0.92-0.06*Drift, 1.05+0.03*sin(Drift*1.7))
	d := (uv - at) * vec2(size.x/size.y, 1)
	col = mix(col, Wash.rgb, exp(-dot(d, d)/0.22)*Wash.a)

	// Light from above, and the fibres of the sheet.
	col *= 1 + Light*(0.5-uv.y)
	col += (hash(floor(dst.xy)) - 0.5) * 0.022
	return vec4(col, 1)
}
